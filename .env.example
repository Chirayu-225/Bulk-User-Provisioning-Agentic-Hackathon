# Copy to .env and fill in. Everything here is free.

# LLM: gemini (free key from https://aistudio.google.com), openai (Ollama/Groq/any OpenAI-compatible), or none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local GPU option via Ollama (ollama pull qwen2.5:3b), set LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:3b

# Set HEADLESS=0 to watch the browser during the demo; SLOW_MO_MS slows each action down
HEADLESS=1
SLOW_MO_MS=0
BATCH_SIZE=5
